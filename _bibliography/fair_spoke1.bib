@inproceedings{mazzoni_genfair_2023,
	address = {Cham},
	series = {Lecture {Notes} in {Computer} {Science}},
	title = {{GenFair}: {A} {Genetic} {Fairness}-{Enhancing} {Data} {Generation} {Framework}},
	isbn = {978-3-031-45275-8},
	shorttitle = {{GenFair}},
	doi = {10.1007/978-3-031-45275-8_24},
	abstract = {Bias in the training data can be inherited by Machine Learning models and then reproduced in socially-sensitive decision-making tasks leading to potentially discriminatory decisions. The state-of-the-art of pre-processing methods to mitigate unfairness in datasets mainly considers a single binary sensitive attribute. We devise GenFair, a fairness-enhancing data pre-processing method that is able to deal with two or more sensitive attributes, possibly multi-valued, at once. The core of the approach is a genetic algorithm for instance generation, which accounts for the plausibility of the synthetic instances w.r.t. the distribution of the original dataset. Results show that GenFair is on par or even better than state-of-the-art approaches.},
	language = {en},
	booktitle = {Discovery {Science}},
	publisher = {Springer Nature Switzerland},
	author = {Mazzoni, Federico and Manerba, Marta Marchiori and Cinquini, Martina and Guidotti, Riccardo and Ruggieri, Salvatore},
