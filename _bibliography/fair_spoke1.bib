@inproceedings{pellungrini_attacking_2024,
	title = {Attacking {Differential} {Privacy} in {Image} {Processing} with {Denoising} {Methodologies}},
	shorttitle = {{AttDiffPriv}},
	abstract = {Images are used in applications of the utmost importance, ranging from medical analyses to security surveillance etc. 
Unfortunately, the large availability of images poses ethical concerns related to the privacy of the subjects involved. 
For this reason, different obfuscation techniques, such as pixelization and blurring, have been used in order to protect images or parts of them. 
An even greater level of protection has been achieved with the application of Differential Privacy to the field of image processing. 
However, advancements in machine learning techniques for image denoising may be effective in diminishing the protection given by Differential Privacy.
In this work we verify the robustness of privacy protection methods in image processing based on differential privacy against image reconstruction models. 
We design and simulate attacks aiming at reconstructing the original images and we evaluate data quality with image specific metrics and by testing machine learning models for image classification. 
Our experiments show that 
when privacy algorithms guarantee very strong protection against our Denoising Attack, the protected images are useless for any further analyses.},
	booktitle = {{IEEE} {Access}},
	author = {Pellungrini, Roberto and Monreale, Anna and Guidotti, Riccardo},
	year = {2024},
	keywords = {⛔ No INSPIRE recid found, fair:spoke:1, fair:wp:6.3, status:submitted, fair:RBTAI, fair:report:2},
}

@article{di_vece_commodity-specific_2024,
	title = {Commodity-specific triads in the {Dutch} inter-industry production network},
	volume = {14},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-024-53655-3},
	doi = {10.1038/s41598-024-53655-3},
	abstract = {Abstract 
            Triadic motifs are the smallest building blocks of higher-order interactions in complex networks and can be detected as over-occurrences with respect to null models with only pair-wise interactions. Recently, the motif structure of production networks has attracted attention in light of its possible role in the propagation of economic shocks. However, its characterization at the level of individual commodities is still poorly understood. Here we analyze both binary and weighted triadic motifs in the Dutch inter-industry production network disaggregated at the level of 187 commodity groups, which Statistics Netherlands reconstructed from National Accounts registers, surveys and known empirical data. We introduce appropriate null models that filter out node heterogeneity and the strong effects of link reciprocity and find that, while the aggregate network that overlays all products is characterized by a multitude of triadic motifs, most single-product layers feature no significant motif, and roughly 85\% of the layers feature only two motifs or less. This result paves the way for identifying a simple ‘triadic fingerprint’ of each commodity and for reconstructing most product-specific networks from partial information in a pairwise fashion by controlling for their reciprocity structure. We discuss how these results can help statistical bureaus identify fine-grained information in structural analyses of interest for policymakers.},
	language = {en},
	number = {1},
	urldate = {2024-02-22},
	journal = {Scientific Reports},
	author = {Di Vece, Marzio and Pijpers, Frank P. and Garlaschelli, Diego},
	month = feb,
	year = {2024},
	keywords = {⛔ No INSPIRE recid found, fair:spoke:1, status:published, fair:wp:4.1, fair:HAI, fair:multidisciplinary, fair:author:foreign, fair:report:2},
	pages = {3625},
}

