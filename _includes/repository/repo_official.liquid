{% assign repo_url = include.repository | split: '/' %}
{% assign username = repo_url[0] %}
{% assign reponame = repo_url[1] %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}" class="repo-link">
    <div class="repo-card">
      <div class="repo-header">
        <svg class="repo-icon" height="16" width="16" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z"></path>
        </svg>
        <span class="repo-name">{{ username }}/{{ reponame }}</span>
      </div>
      <div class="repo-badges">
        <img src="https://img.shields.io/github/stars/{{ username }}/{{ reponame }}?style=social" alt="Stars">
        <img src="https://img.shields.io/github/forks/{{ username }}/{{ reponame }}?style=social" alt="Forks">
        <img src="https://img.shields.io/github/watchers/{{ username }}/{{ reponame }}?style=social" alt="Watchers">
      </div>
      <div class="repo-stats">
        <img src="https://img.shields.io/github/last-commit/{{ username }}/{{ reponame }}" alt="Last Commit">
        <img src="https://img.shields.io/github/languages/top/{{ username }}/{{ reponame }}" alt="Language">
        <img src="https://img.shields.io/github/license/{{ username }}/{{ reponame }}" alt="License">
      </div>
    </div>
  </a>
</div>
